{
  "name": "engage-backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "node ./node_modules/@nestjs/cli/bin/nest.js build",
    "db:schema": "node scripts/run-sql.js db/schema.sql",
    "db:seed": "node scripts/run-sql.js db/seed.sql",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "start:dev": "node ./node_modules/@nestjs/cli/bin/nest.js start --watch",
    "test:analysis": "node --test test/analysis.service.test.js",
    "test:follow-ups": "node --test test/follow-up.service.test.js",
    "test:engage": "node --test test/engage.test.js",
    "demo:data": "node scripts/demo-data.js",
    "db:setup": "node scripts/db-setup.js",
    "test:advisor": "node --test test/advisor.test.js",
    "test:extractor": "node --test test/extractor.test.js"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.7.0"
  }
}
